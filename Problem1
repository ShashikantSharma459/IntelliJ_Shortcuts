class Solution {
    public int[] solution(int N) {
        for (int A = 1; A < N; A++) {
            int B = N - A;
            if (isValid(A) && isValid(B)) {
                return new int[]{A, B};
            }
        }
        // Should never reach here for valid input N > 1
        return new int[]{-1, -1};
    }

    private boolean isValid(int num) {
        while (num > 0) {
            if (num % 10 == 0) return false;
            num /= 10;
        }
        return true;
    }
}
